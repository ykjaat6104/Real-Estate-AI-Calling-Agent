# Real Estate AI Calling Agent - Environment Variables

# App
SECRET_KEY=your-secret-key-change-in-production
DEBUG=false

# Supabase / PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:6543/postgres

# Redis
REDIS_URL=redis://localhost:6379/0

# LiveKit (media server)
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# Groq (LLM brain) — https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Deepgram (speech-to-text) — https://console.deepgram.com
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY

# ElevenLabs (text-to-speech) — https://elevenlabs.io
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
TTS_VOICE_ID=your-voice-id

# Optional tweaks
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=hi
TTS_MODEL=eleven_multilingual_v2

# Agent
AGENT_NAME=real-estate-agent

# JWT Auth
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
JWT_REFRESH_EXPIRY_DAYS=7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_TENANT_PER_HOUR=1000

# Twilio (optional - for phone calling)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CORS
CORS_ORIGINS=["*"]

# Storage
RECORDINGS_PATH=./recordings
